{
  "name": "token-sync-poc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p figma-plugin/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src figma-plugin scripts",
    "lint:fix": "oxlint --fix src figma-plugin scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "plugin:build": "node figma-plugin/scripts/build-plugin.mjs",
    "plugin:watch": "node --watch-path=figma-plugin/src figma-plugin/scripts/build-plugin.mjs",
    "tokens:sync": "node scripts/sync-pebble-tokens.mjs sync",
    "tokens:check": "node scripts/sync-pebble-tokens.mjs check",
    "tokens:push": "node scripts/sync-pebble-tokens.mjs push",
    "tokens:fixture": "node scripts/sync-pebble-tokens.mjs fixture",
    "tokens:to-dtcg": "node scripts/sync-pebble-tokens.mjs to-dtcg",
    "tokens:prune": "node scripts/sync-pebble-tokens.mjs prune",
    "tokens:to-rgba": "node scripts/sync-pebble-tokens.mjs to-rgba",
    "tokens:to-rgba:check": "node scripts/sync-pebble-tokens.mjs to-rgba --check",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build && npm run plugin:build"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.138.0",
    "@types/node": "^26.6.2",
    "oxlint": "^1.85.0",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}

{
  "icon": {
    "size": {
      "xs": {
        "$type": "dimension",
        "$value": {
          "value": 12,
          "unit": "px"
        }
      },
      "sm": {
        "$type": "dimension",
        "$value": {
          "value": 16,
          "unit": "px"
        }
      },
      "md": {
        "$type": "dimension",
        "$value": {
          "value": 24,
          "unit": "px"
        }
      },
      "lg": {
        "$type": "dimension",
        "$value": {
          "value": 32,
          "unit": "px"
        }
      },
      "xl": {
        "$type": "dimension",
        "$value": {
          "value": 48,
          "unit": "px"
        }
      },
      "2xl": {
        "$type": "dimension",
        "$value": {
          "value": 64,
          "unit": "px"
        }
      }
    },
    "state": {
      "default": {},
      "disabled": {
        "opacity": {
          "$type": "number",
          "$value": 0.5
        }
      }
    }
  }
}

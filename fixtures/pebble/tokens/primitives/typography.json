{
  "primitives": {
    "typography": {
      "fontFamily": {
        "sans": {
          "$type": "fontFamily",
          "$value": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
          "$description": "Default sans-serif font stack"
        },
        "serif": {
          "$type": "fontFamily",
          "$value": "Georgia, Cambria, 'Times New Roman', Times, serif",
          "$description": "Serif font stack"
        },
        "mono": {
          "$type": "fontFamily",
          "$value": "'SF Mono', Monaco, 'Cascadia Code', 'Roboto Mono', Consolas, 'Courier New', monospace",
          "$description": "Monospace font stack for code"
        }
      },
      "fontWeight": {
        "light": {
          "$type": "fontWeight",
          "$value": 300
        },
        "regular": {
          "$type": "fontWeight",
          "$value": 400
        },
        "medium": {
          "$type": "fontWeight",
          "$value": 500
        },
        "semibold": {
          "$type": "fontWeight",
          "$value": 600
        },
        "bold": {
          "$type": "fontWeight",
          "$value": 700
        },
        "extrabold": {
          "$type": "fontWeight",
          "$value": 800
        }
      },
      "fontSize": {
        "xs": {
          "$type": "dimension",
          "$value": {
            "value": 0.75,
            "unit": "rem"
          },
          "$description": "12px"
        },
        "sm": {
          "$type": "dimension",
          "$value": {
            "value": 0.875,
            "unit": "rem"
          },
          "$description": "14px"
        },
        "base": {
          "$type": "dimension",
          "$value": {
            "value": 1,
            "unit": "rem"
          },
          "$description": "16px"
        },
        "lg": {
          "$type": "dimension",
          "$value": {
            "value": 1.125,
            "unit": "rem"
          },
          "$description": "18px"
        },
        "xl": {
          "$type": "dimension",
          "$value": {
            "value": 1.25,
            "unit": "rem"
          },
          "$description": "20px"
        },
        "2xl": {
          "$type": "dimension",
          "$value": {
            "value": 1.5,
            "unit": "rem"
          },
          "$description": "24px"
        },
        "3xl": {
          "$type": "dimension",
          "$value": {
            "value": 1.875,
            "unit": "rem"
          },
          "$description": "30px"
        },
        "4xl": {
          "$type": "dimension",
          "$value": {
            "value": 2.25,
            "unit": "rem"
          },
          "$description": "36px"
        },
        "5xl": {
          "$type": "dimension",
          "$value": {
            "value": 3,
            "unit": "rem"
          },
          "$description": "48px"
        },
        "6xl": {
          "$type": "dimension",
          "$value": {
            "value": 3.75,
            "unit": "rem"
          },
          "$description": "60px"
        },
        "7xl": {
          "$type": "dimension",
          "$value": {
            "value": 4.5,
            "unit": "rem"
          },
          "$description": "72px"
        }
      },
      "lineHeight": {
        "none": {
          "$type": "number",
          "$value": 1
        },
        "tight": {
          "$type": "number",
          "$value": 1.25
        },
        "snug": {
          "$type": "number",
          "$value": 1.375
        },
        "normal": {
          "$type": "number",
          "$value": 1.5
        },
        "relaxed": {
          "$type": "number",
          "$value": 1.625
        },
        "loose": {
          "$type": "number",
          "$value": 2
        }
      },
      "letterSpacing": {
        "tighter": {
          "$type": "number",
          "$value": -0.05
        },
        "tight": {
          "$type": "number",
          "$value": -0.025
        },
        "normal": {
          "$type": "number",
          "$value": 0
        },
        "wide": {
          "$type": "number",
          "$value": 0.025
        },
        "wider": {
          "$type": "number",
          "$value": 0.05
        },
        "widest": {
          "$type": "number",
          "$value": 0.1
        }
      }
    }
